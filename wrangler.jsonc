{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolforge-api",
  "main": "worker.py",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,

  // LLM Provider config (non-secret)
  "vars": {
    "ENVIRONMENT": "development",
    "LLM_PROVIDER": "minimax",
    "LLM_BASE_URL": "https://api.minimaxi.com/anthropic",
    "LLM_MODEL": "minimax/MiniMax-M3",
    "TOOLFORGE_VERSION": "0.1.0-p3",
    "OWNER_TELEGRAM_CHAT_ID": "",  // Set via wrangler secret put
    // CORS: comma-separated allowed origins. Empty = "*" (dev only).
    // Examples:
    //   "https://toolforge.vn"  (single)
    //   "https://toolforge.vn,https://admin.toolforge.vn"  (multiple)
    "ALLOWED_ORIGINS": "",
    // SePay bank info (set via wrangler secret put in production)
    "SEPAY_BANK_CODE": "VCB",
    "SEPAY_BANK_NAME": "Vietcombank",
    "SEPAY_ACCOUNT_NUMBER": "0000000000",
    "SEPAY_ACCOUNT_HOLDER": "TOOLFORGE"
  },

  // D1 database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toolforge-db",
      "database_id": "737a5cf6-7f47-4665-9455-b724241a9375",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for tool binaries
  "r2_buckets": [
    {
      "binding": "TOOLS_BUCKET",
      "bucket_name": "toolforge-tools"
    }
  ],

  // KV namespace for session/cache
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b8b89153803c42b7bccd9c15cfc5dbae"
    }
  ],

  // Cron Triggers — DISABLED because the account already has 5 cron
  // triggers (CF Workers free-plan limit per account). Re-enable after
  // freeing up at least 1 slot from another Worker.

  // Secrets (set via `wrangler secret put`):
  // - LLM_API_KEY               (MiniMax M3 key)
  // - OWNER_TELEGRAM_BOT_TOKEN  (Telegram bot from @BotFather, for Helper)
  // - OWNER_TELEGRAM_CHAT_ID    (Owner's numeric chat_id for daily report)
  // - TELEGRAM_WEBHOOK_SECRET   (optional, validates X-Telegram-Bot-Api-Secret-Token)
  // - META_ADS_TOKEN (P2+)
  // - TIKTOK_BUSINESS_TOKEN (P2+)
  // - SEPAY_API_KEY (P2+)
  // - WEBHOOK_SECRET            (HMAC for /api/forge/webhook/built, REQUIRED in production)

  // Observability
  "observability": {
    "enabled": true
  }
  // CPU limits (`limits.cpu_ms`) are a paid-plan feature; removed for free tier.
  // Workers free plan still has 30s wall-time per request, enforced at the
  // platform level — no config needed here.
}
