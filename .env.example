# ToolForge environment variables (LOCAL DEV ONLY)
# Production secrets go through `wrangler secret put`
# Copy this file to `.env` and fill in for local testing.

# === MiniMax LLM (REQUIRED for /api/llm/test) ===
LLM_API_KEY=sk-cp-...
LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLM_MODEL=minimax/MiniMax-M3

# === Environment ===
ENVIRONMENT=development
TOOLFORGE_VERSION=0.1.0-p0

# === Telegram bot (P5+ for Helper, P0 stub) ===
OWNER_TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=

# === Meta + TikTok ads (P2+) ===
META_ADS_TOKEN=
TIKTOK_BUSINESS_TOKEN=

# === SePay payment (P2+) ===
SEPAY_API_KEY=
